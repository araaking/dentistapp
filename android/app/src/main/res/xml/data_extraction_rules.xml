<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: data aplikasi (token login, jawaban kesehatan) tidak ikut
     cadangan cloud maupun transfer antarperangkat. Melengkapi
     android:allowBackup="false" yang tidak mencakup transfer antarperangkat. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
